# AI Services Module - Production Configuration
# Last Updated: 2026-04-28

# === Application Configuration ===
NODE_ENV=production
PORT=3000
API_VERSION=v1
MODEL_MODE=real

# === JWT Configuration ===
JWT_SECRET=${JWT_SECRET_VAULT}
JWT_EXPIRATION=24h

# === Database Configuration (PostgreSQL) ===
DATABASE_HOST=${DB_HOST}
DATABASE_PORT=5432
DATABASE_NAME=${DB_NAME}
DATABASE_USER=${DB_USER}
DATABASE_PASSWORD=${DB_PASSWORD}
DATABASE_SSL=true
DATABASE_LOG=false
DATABASE_SYNC=false
DATABASE_POOL_SIZE=20

# === Redis Configuration ===
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_CACHE_TTL_TEMPLATES=3600
REDIS_CACHE_TTL_QUESTIONS=7200

# === RabbitMQ Configuration ===
RABBITMQ_HOST=${RABBITMQ_HOST}
RABBITMQ_PORT=5672
RABBITMQ_USER=${RABBITMQ_USER}
RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD}
RABBITMQ_VHOST=/
RABBITMQ_QUEUE_NAME=question_generation_queue
RABBITMQ_DLQ_NAME=question_generation_dlq

# === Logging Configuration ===
LOG_LEVEL=warn
LOG_FORMAT=json
LOG_FILE=/var/log/app/app.log
LOG_ERROR_FILE=/var/log/app/error.log

# === Security Configuration ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
ENABLE_CORS=true
ALLOWED_ORIGINS=${ALLOWED_ORIGINS}

# === Feature Flags ===
ENABLE_ASYNC_PROCESSING=true
ENABLE_CACHING=true
ENABLE_AUDIT_LOG=true
ENABLE_EMAIL_NOTIFICATIONS=true

# === Monitoring & Tracing ===
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_LOGGING=true
TRACE_ENABLED=true
TRACE_ENDPOINT=${TRACE_ENDPOINT}
